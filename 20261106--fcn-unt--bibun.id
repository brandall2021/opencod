!v062!CIENCIAS BIOLOGICAS
!v062!ZOOLOGIA
!v062!ORTHOPTERA
!v062!BAEACRIS PUNCTULATUS
!v062!INSECTOS
!v062!ACRIDIDAR
!v062!AMERICA DEL SUR
